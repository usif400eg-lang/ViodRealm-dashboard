{
  "rules": {
    "//": "Access model: the OWNER always has full access and manages the admins list.",
    "//2": "Other users are authorized only if their encoded email exists under /admins.",

    "servers": {
      "$serverId": {
        ".read": "auth != null && (auth.token.email == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).val() == true)",

        "waypoints": { ".write": false },
        "stats": { ".write": false },
        "players": { ".write": false },
        "knownPlayers": { ".write": false },
        "bans": { ".write": false },
        "whitelist": { ".write": false },
        "ranks": { ".write": false },

        "commands": {
          ".read": "auth != null && (auth.token.email == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).val() == true)",
          ".write": "auth != null && (auth.token.email == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).val() == true)"
        }
      }
    },

    "admins": {
      "//": "Only the owner may read the full list and add/remove admins.",
      ".read": "auth != null && auth.token.email == 'usif400.eg@gmail.com'",
      ".write": "auth != null && auth.token.email == 'usif400.eg@gmail.com'",

      "$emailKey": {
        "//": "Each user may read their own admin flag so the dashboard can check authorization.",
        ".read": "auth != null"
      }
    }
  }
}
