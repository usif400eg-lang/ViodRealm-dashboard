{
  "rules": {
    "servers": {
      "$serverId": {
        ".read": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())",
        "waypoints": { ".write": false },
        "stats": { ".write": false },
        "players": { ".write": false },
        "knownPlayers": { ".write": false },
        "bans": { ".write": false },
        "whitelist": { ".write": false },
        "ranks": { ".write": false },
        "activity": { ".write": false },
        "history": { ".write": false },
        "categoryStats": { ".write": false },
        "worlds": { ".write": false },
        "plugins": { ".write": false },
        "inspect": { ".write": false },
        "pluginInstall": { ".write": false },
        "commands": {
          ".read": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())"
        }
      }
    },
    "admins": {
      ".read": "auth != null && auth.token.email.toLowerCase() == 'usif400.eg@gmail.com'",
      ".write": "auth != null && auth.token.email.toLowerCase() == 'usif400.eg@gmail.com'",
