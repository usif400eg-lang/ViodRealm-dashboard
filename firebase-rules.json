{
  "rules": {
    "servers": {
      "$serverId": {
        ".read": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && !newData.exists() && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('serverMeta').child($serverId).child('ownerUid').val() == auth.uid)",
        "waypoints": { ".write": false },
        "stats": { ".write": false },
        "players": { ".write": false },
        "knownPlayers": { ".write": false },
        "bans": { ".write": false },
        "mutes": { ".write": false },
        "reports": { ".write": false },
        "alerts": { ".write": false },
        "scheduledTasks": { ".write": false },
        "whitelist": { ".write": false },
        "ranks": { ".write": false },
        "activity": { ".write": false },
        "history": { ".write": false },
        "categoryStats": { ".write": false },
        "worlds": { ".write": false },
        "plugins": { ".write": false },
        "inspect": { ".write": false },
        "pluginInstall": { ".write": false },
        "authUsers": { ".write": false },
        "chat": { ".write": false },
        "consoleLog": { ".write": false },
        "files": { ".write": false },
        "backup": { ".write": false },
        "power": { ".write": false },
        "panelConfig": {
          ".write": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || root.child('admins').child(auth.uid).exists())"
        },
        "chatOut": {
          ".read": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || root.child('admins').child(auth.uid).exists())"
        },
        "commands": {
          ".read": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || root.child('admins').child(auth.uid).exists())"
        }
      }
    },
    "serverMeta": {
      ".read": "auth != null && auth.token.email.toLowerCase() == 'usif400.eg@gmail.com'",
      "$serverId": {
        ".read": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || root.child('userServers').child(auth.uid).child($serverId).exists() || data.child('ownerUid').val() == auth.uid)",
        ".write": "auth != null && (auth.token.email.toLowerCase() == 'usif400.eg@gmail.com' || !data.exists() || data.child('ownerUid').val() == auth.uid)",
        "name":        { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 64" },
        "online":      { ".read": "auth != null", ".write": false },
        "lastSeen":    { ".read": "auth != null", ".write": false },
        "instanceId":  { ".read": "auth != null", ".write": false },
        "pairingCode": { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 32" },
        "port":        { ".read": "auth != null", ".validate": "newData.isNumber()" },
        "configVersion": { ".read": "auth != null", ".validate": "newData.isNumber()" },
        "group":       { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 64" },
        "description": { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 500" },
        "accent":      { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 16" },
        "createdAt":   { ".read": "auth != null", ".validate": "newData.isNumber()" },
        "ownerUid":    { ".read": "auth != null", ".validate": "newData.isString()" },
        "nodePolicy":  { ".read": "auth != null" },
        "authToken": {
          ".read": "auth != null && data.parent().child('ownerUid').val() == auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 256"
        }
      }
    },
    "pairingCodes": {
      "$code": {
        ".read": "auth != null"
      }
    },
    "userServers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "admins": {
      ".read": "auth != null && auth.token.email.toLowerCase() == 'usif400.eg@gmail.com'",
      ".write": "auth != null && auth.token.email.toLowerCase() == 'usif400.eg@gmail.com'",
      "$key": {
        ".read": "auth != null"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "siteConfig": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email.toLowerCase() == 'usif400.eg@gmail.com'"
    }
  }
}
