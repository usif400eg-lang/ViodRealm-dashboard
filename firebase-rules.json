{
  "rules": {
    "//": "Access model: OWNER always has full access and manages the admins list.",
    "//2": "Others are authorized if their encoded email OR their auth uid exists under /admins.",

    "servers": {
      "$serverId": {
        ".read": "auth != null && (auth.token.email == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())",

        "waypoints": { ".write": false },
        "stats": { ".write": false },
        "players": { ".write": false },
        "knownPlayers": { ".write": false },
        "bans": { ".write": false },
        "whitelist": { ".write": false },
        "ranks": { ".write": false },
        "activity": { ".write": false },
        "history": { ".write": false },
        "categoryStats": { ".write": false },
        "worlds": { ".write": false },

        "commands": {
          ".read": "auth != null && (auth.token.email == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.token.email == 'usif400.eg@gmail.com' || root.child('admins').child(auth.token.email.replace('.', ',').replace('#', ',').replace('$', ',').replace('[', ',').replace(']', ',')).exists() || root.child('admins').child(auth.uid).exists())"
        }
      }
    },

    "admins": {
      "//": "Only the owner may read the full list and add/remove admins.",
      ".read": "auth != null && auth.token.email == 'usif400.eg@gmail.com'",
      ".write": "auth != null && auth.token.email == 'usif400.eg@gmail.com'",

      "$key": {
        "//": "Each user may read their own entry (by email key or uid) to check authorization.",
        ".read": "auth != null"
      }
    }
  }
}
